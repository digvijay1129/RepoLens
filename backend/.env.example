APP_NAME=RepoLens API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Local PostgreSQL connection. Replace the placeholder with your local value.
# Never commit backend/.env.
DATABASE_URL=postgresql+psycopg://repolens_user:change_me@localhost:5432/repolens

# REQUIRED for registration/login. Generate a private local value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Replace this placeholder; do not reuse it in production.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Embeddings are optional. Source indexing works with these disabled.
# To generate vectors, enable embeddings and set a provider-compatible API key.
EMBEDDINGS_ENABLED=false
EMBEDDINGS_PROVIDER=openai_compatible
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSIONS=1536
EMBEDDINGS_BATCH_SIZE=32
EMBEDDINGS_TIMEOUT_SECONDS=30

# Preferred shared OpenRouter settings for chat and optional embeddings.
# Get a key from https://openrouter.ai/keys. Keep it private and never commit it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-5.6-luna
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=RepoLens

# RAG chat is separate from embeddings and disabled until explicitly configured.
# Source context is sent to this provider. Never commit backend/.env.
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_COMPLETION_TOKENS=1200
LLM_MAX_RETRIES=2
RAG_CONTEXT_CHUNKS=8
RAG_HISTORY_MESSAGES=8
