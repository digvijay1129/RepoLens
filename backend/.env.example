APP_NAME=RepoLens API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Local PostgreSQL connection. Replace the placeholder with your local value.
# Never commit backend/.env.
DATABASE_URL=postgresql+psycopg://repolens_user:change_me@localhost:5432/repolens

# REQUIRED for registration/login. Generate a private local value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Replace this placeholder; do not reuse it in production.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
